# ---------------------------------------------------------------------------
# Sanity — from https://sanity.io/manage
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin a date. Bumping it opts into API behaviour changes, so do it deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Viewer role. Powers draft previews and the Live Content API.
SANITY_API_READ_TOKEN=

# Editor role. Used by scripts/seed.ts ONLY — never add this to Vercel.
SANITY_API_WRITE_TOKEN=

# Must match the secret on the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mux credentials are NOT set here. You enter them once inside the Studio UI
# (/studio -> Mux tab); the plugin stores them as a private document in the dataset.
